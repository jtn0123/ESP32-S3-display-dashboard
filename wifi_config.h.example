// WiFi Configuration Example
// Copy this file to wifi_config.h and add your actual WiFi credentials
// DO NOT commit wifi_config.h to git (it's in .gitignore)

#define WIFI_SSID "YourWiFiSSID"
#define WIFI_PASSWORD "YourWiFiPassword"

// Shared secret for the remote restart endpoints (POST /restart, POST
// /api/restart). Generate a unique random value per device, e.g.
//     openssl rand -hex 24
// If this is absent (or the RESTART_TOKEN environment variable is unset at
// build time) both endpoints are DISABLED and return 503 — the firmware will
// not fall back to a default. Earlier builds hardcoded a shared token that was
// published in this repository; do not reintroduce one.
#define RESTART_TOKEN "generate-a-unique-random-value-per-device"

// Password for the OTA firmware-upload endpoint (POST /ota/update, header
// X-OTA-Password). Same rules as above: unique, random, per device. If absent
// the endpoint is DISABLED and returns 503. This guards arbitrary firmware
// upload, so treat it as the most sensitive value in this file. Earlier builds
// hardcoded "esp32" here.
#define OTA_PASSWORD "generate-a-unique-random-value-per-device"